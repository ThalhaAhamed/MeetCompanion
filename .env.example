# ============================================================
# Meet Companion — Environment Variables
# ============================================================
# Copy this file to .env and edit as needed:
#     cp .env.example .env
#
# Every value below has a working default. You can start the
# application with an empty .env and configure the rest from the
# in-app onboarding flow.
#
# NEVER commit .env to version control.
# ============================================================


# ------------------------------------------------------------
# Database  (optional — defaults to a local SQLite file)
# ------------------------------------------------------------
# SQLite needs no server, no container and no setup. The file and
# its parent directory are created automatically on first run.
DATABASE_URL=sqlite+aiosqlite:///data/meet-companion.db

# To use PostgreSQL instead, point at your server. The pgvector
# extension is required and is enabled automatically if permitted.
#   docker compose up -d   # starts a ready-made pgvector server
# DATABASE_URL=postgresql+asyncpg://meet:meet_dev_password@localhost:5432/meet_companion


# ------------------------------------------------------------
# LLM  (optional — used for memory extraction and Ask AI)
# ------------------------------------------------------------
# One set of variables works for every provider. Anything left
# blank falls back to that provider's documented default.
#
# Supported: ollama, openai, anthropic, gemini, groq, openai_compatible
LLM_PROVIDER=ollama

# Model name. Defaults per provider, e.g. llama3.1 for Ollama.
# LLM_MODEL=llama3.1

# Required for every hosted provider. Not needed for Ollama.
# LLM_API_KEY=

# Override only for self-hosted endpoints, proxies or gateways.
# For Ollama this is the host, default http://localhost:11434
# LLM_BASE_URL=

# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=


# ------------------------------------------------------------
# MeetStream  (required only to send bots into live meetings)
# ------------------------------------------------------------
# Meet Companion uses MeetStream to join calls and produce
# transcripts. Leave blank to use notes, search and Ask AI
# without live meeting capture.
MEETSTREAM_API_KEY=
MEETSTREAM_API_BASE_URL=https://api.meetstream.ai
MEETSTREAM_WEBHOOK_SECRET=
MEETSTREAM_AGENT_CONFIG_ID=


# ------------------------------------------------------------
# MCP server  (lets the in-call agent query your meeting memory)
# ------------------------------------------------------------
# Change MCP_AUTH_TOKEN to any random string before exposing this
# server beyond your own machine.
MCP_AUTH_TOKEN=change-me-to-a-random-string
MCP_SERVER_URL=http://localhost:8000/mcp


# ------------------------------------------------------------
# Embeddings  (runs locally — no API key, nothing leaves the machine)
# ------------------------------------------------------------
# Changing the model usually changes EMBEDDING_DIMENSION too, and
# existing embeddings must be regenerated to stay comparable.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=500
CHUNK_OVERLAP=100


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]


# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
# Change before any deployment others can reach.
API_KEY_SALT=change-me-to-a-random-string
