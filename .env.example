# ============================================================
# MeetStream Companion — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://meetstream:meetstream_dev_password@localhost:5432/meetstream_companion
DATABASE_URL_SYNC=postgresql://meetstream:meetstream_dev_password@localhost:5432/meetstream_companion

# ---- MeetStream ----
MEETSTREAM_API_KEY=your_meetstream_api_key_here
MEETSTREAM_API_BASE_URL=https://api.meetstream.ai
MEETSTREAM_WEBHOOK_SECRET=your_webhook_secret_here
MEETSTREAM_AGENT_CONFIG_ID=your_mia_agent_config_id_here

# ---- MCP Server ----
MCP_AUTH_TOKEN=your_mcp_bearer_token_here
MCP_SERVER_URL=http://localhost:8000/mcp

# ---- LLM (Memory Extraction) ----
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1

# ---- Embedding ----
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ---- Application ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# ---- Security ----
API_KEY_SALT=change_this_to_a_random_string
